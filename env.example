# Copy this file to .env at the project root and fill in real values.
# NEVER commit the real .env -- it should already be covered by .gitignore.

# ClickHouse Cloud connection. Do NOT include a port suffix on the host --
# config.py strips one defensively, but avoid the confusing double-port
# error by leaving it off here in the first place.
CLICKHOUSE_HOST=your-instance.clickhouse.cloud
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Google AI Studio API key (free tier, no card required):
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Gemini model to use for all agents. Kept configurable here (not hardcoded)
# because free-tier model availability and quotas have changed multiple
# times during development -- check https://ai.dev/rate-limit if this model
# stops working and swap in whatever's current.
GEMINI_MODEL=gemini-3.5-flash-lite
