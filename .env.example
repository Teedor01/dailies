# Copy this file to .env and fill in real values. Never commit .env itself.

# --- ClickHouse Cloud (from the "Connect" panel in your service dashboard) ---
CLICKHOUSE_HOST=xxxxx.region.aws.clickhouse.cloud
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# --- Google / Gemini (for tool_reasoner.py, pure_reasoner.py -- next step) ---
GOOGLE_API_KEY=
# or, if using Vertex AI instead of the Gemini API directly:
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=
